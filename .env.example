# IPTV Web Player 环境变量配置
# 复制本文件为 .env 后填入实际值

# 服务端口（默认 5005）
IPTV_PORT=5005

# IPTV 播放列表地址
IPTV_PLAYLIST_URL=https://raw.githubusercontent.com/YueChan/Live/main/GNTV.m3u

# Clash 代理地址（用于访问被墙资源）
# 示例: http://192.168.1.146:7890
# 留空则不使用代理
CLASH_PROXY=

# 日志级别: DEBUG, INFO, WARNING, ERROR
IPTV_LOG_LEVEL=INFO

# 是否启用速率限制
IPTV_RATE_LIMIT=true
