#!/usr/bin/env python3
"""
IPTV Web 播放器 - 单文件 Flask 应用
支持：动态加载 M3U、点击切换、服务端代理模式、手机兼容
"""

import re
import time
import threading
import os
from concurrent.futures import ThreadPoolExecutor
import requests
from urllib.parse import urlparse, urljoin, quote
from flask import Flask, render_template_string, request, Response, jsonify

# Clash 代理配置（后端按需使用）
CLASH_PROXY = os.environ.get('CLASH_PROXY', 'http://127.0.0.1:7890')
CLASH_PROXIES = {'http': CLASH_PROXY, 'https': CLASH_PROXY}
NO_PROXIES = None

app = Flask(__name__)

PLAYLIST_URL = "https://raw.githubusercontent.com/YueChan/Live/main/GNTV.m3u"

# ========== 健康状态缓存 ==========
_health_cache = {}
_playlist_cache = {"channels": None, "fetched_at": 0, "error": None}
_cache_lock = threading.Lock()
CACHE_TTL = 300  # 5分钟
PLAYLIST_CACHE_TTL = 300  # 播放列表缓存 5 分钟


def _check_single_mode(url: str, use_clash: bool = False) -> dict:
    """检测单个频道的可用性，返回 {status, latency, error}"""
    if url.startswith("rtmp://"):
        return {"status": "red", "latency": None, "error": "RTMP 浏览器不支持"}

    proxies = CLASH_PROXIES if use_clash else NO_PROXIES

    start = time.time()
    try:
        # HLS 源：检测 m3u8 + 第一个 ts 切片
        if ".m3u8" in url or "/tracks-" in url:
            r = requests.get(url, timeout=(2, 4), headers={"User-Agent": "Mozilla/5.0"}, stream=True, proxies=proxies)
            r.raise_for_status()

            # 读取前 2KB 确认是有效 m3u8
            chunk = r.raw.read(2048)
            text = chunk.decode("utf-8", errors="ignore")
            if not text.strip().startswith("#EXTM3U"):
                return {"status": "red", "latency": time.time()-start, "error": "无效的 m3u8"}

            # 提取第一个 ts 路径
            ts_url = None
            for line in text.splitlines():
                line = line.strip()
                if line and not line.startswith("#"):
                    ts_url = line
                    break

            # 如果首块未读完，继续读一点找 ts
            if not ts_url:
                chunk2 = r.raw.read(2048)
                text2 = chunk2.decode("utf-8", errors="ignore")
                for line in text2.splitlines():
                    line = line.strip()
                    if line and not line.startswith("#"):
                        ts_url = line
                        break

            if ts_url:
                absolute_ts = urljoin(url, ts_url)
                ts_r = requests.head(absolute_ts, timeout=(2, 4), headers={"User-Agent": "Mozilla/5.0"}, allow_redirects=True, proxies=proxies)
                ts_r.raise_for_status()
                total_latency = time.time() - start

                if ts_r.status_code == 200:
                    if total_latency < 2:
                        return {"status": "green", "latency": round(total_latency, 2), "error": None}
                    else:
                        return {"status": "yellow", "latency": round(total_latency, 2), "error": "较慢"}
                else:
                    return {"status": "yellow", "latency": round(total_latency, 2), "error": f"ts {ts_r.status_code}"}
            else:
                return {"status": "yellow", "latency": round(time.time()-start, 2), "error": "无媒体片段"}
        else:
            # 非 HLS 直接流
            r = requests.head(url, timeout=(2, 4), headers={"User-Agent": "Mozilla/5.0"}, allow_redirects=True, proxies=proxies)
            r.raise_for_status()
            latency = time.time() - start
            if latency < 2:
                return {"status": "green", "latency": round(latency, 2), "error": None}
            else:
                return {"status": "yellow", "latency": round(latency, 2), "error": "较慢"}

    except Exception as e:
        return {"status": "red", "latency": round(time.time()-start, 2), "error": str(e)[:50]}


def check_channel(url: str) -> dict:
    """检测单个频道的两种访问模式，返回 {direct, proxy, mode}"""
    direct = _check_single_mode(url, use_clash=False)
    proxy = _check_single_mode(url, use_clash=True)

    # 优先判定可用模式
    if direct["status"] == "green" or direct["status"] == "yellow":
        mode = "direct"
    elif proxy["status"] == "green" or proxy["status"] == "yellow":
        mode = "proxy"
    elif direct["status"] == "red" and proxy["status"] == "red":
        mode = "none"
    else:
        mode = "unknown"

    return {"mode": mode, "direct": direct, "proxy": proxy, "checked_at": time.time()}


def get_channel_health(url: str) -> dict:
    """获取频道健康状态，优先用缓存；无缓存返回 unknown 不触发实时检测"""
    with _cache_lock:
        if url in _health_cache:
            return _health_cache[url]
    # 无缓存时返回默认值，避免阻塞首次加载
    return {"mode": "unknown", "direct": {"status": "unknown"}, "proxy": {"status": "unknown"}, "checked_at": 0}


def check_channels_background(urls, max_workers=20):
    """批量检测频道，并更新播放列表缓存。可同步调用。"""
    def _check_one(url):
        result = check_channel(url)
        result["checked_at"] = time.time()
        with _cache_lock:
            _health_cache[url] = result
            # 同时更新播放列表缓存中的对应频道
            if _playlist_cache["channels"]:
                for ch in _playlist_cache["channels"]:
                    if ch["url"] == url:
                        ch["health"] = result
                        ch["access_mode"] = result["mode"]
                        break

    with ThreadPoolExecutor(max_workers=max_workers) as ex:
        ex.map(_check_one, urls)


# ========== M3U 解析 ==========

def parse_m3u(content: str):
    channels = []
    lines = content.splitlines()
    current = None

    for line in lines:
        line = line.strip()
        if not line:
            continue

        if line.startswith("#EXTINF:"):
            # 提取属性 key="value"
            attrs = {}
            for k, v in re.findall(r'([\w-]+)="([^"]*)"', line):
                attrs[k] = v

            # 提取频道名称（逗号后）
            name = line.split(",", 1)[-1].strip() if "," in line else "未知频道"

            logo = attrs.get("tvg-logo", "")
            # 无图标时尝试从 EPG 服务获取
            if not logo:
                logo = f"https://epg.112114.xyz/logo/{quote(name, safe='')}.png"
            current = {
                "name": name,
                "group": attrs.get("group-title", "未分组"),
                "logo": logo,
                "url": None,
            }

        elif not line.startswith("#") and current is not None:
            current["url"] = line
            channels.append(current)
            current = None

    return channels


def fetch_playlist(force_refresh=False):
    """获取并解析播放列表，支持缓存"""
    with _cache_lock:
        now = time.time()
        if not force_refresh and _playlist_cache["channels"] is not None \
                and (now - _playlist_cache["fetched_at"]) < PLAYLIST_CACHE_TTL:
            return _playlist_cache["channels"], True  # from_cache=True

    # 拉取 M3U
    try:
        r = requests.get(PLAYLIST_URL, timeout=30)
        r.raise_for_status()
    except Exception as e:
        with _cache_lock:
            if _playlist_cache["channels"] is not None:
                return _playlist_cache["channels"], True
        raise

    channels = parse_m3u(r.text)

    # 为每个频道附加健康状态
    for ch in channels:
        health = get_channel_health(ch["url"])
        ch["health"] = health
        ch["access_mode"] = health.get("mode", "unknown")

    with _cache_lock:
        _playlist_cache["channels"] = channels
        _playlist_cache["fetched_at"] = time.time()
        _playlist_cache["error"] = None

    # 启动后台线程检测所有未知状态的频道（不阻塞返回）
    unknown_urls = [ch["url"] for ch in channels if ch.get("access_mode") == "unknown"]
    if unknown_urls:
        t = threading.Thread(target=check_channels_background, args=(unknown_urls, 25), daemon=True)
        t.start()

    return channels, False


# ========== API 路由 ==========

@app.route("/api/playlist")
def api_playlist():
    refresh = request.args.get("refresh", "false").lower() == "true"

    try:
        channels, from_cache = fetch_playlist(force_refresh=refresh)
        with _cache_lock:
            cached_at = _playlist_cache["fetched_at"]
        return jsonify({
            "channels": channels,
            "count": len(channels),
            "from_cache": from_cache,
            "cached_at": cached_at,
        })
    except Exception as e:
        return jsonify({"error": str(e)}), 502


def rewrite_m3u8(content: str, base_url: str) -> str:
    """重写 m3u8 内容中的相对路径为代理 URL"""
    lines = content.splitlines()
    result = []
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("#") or not stripped:
            result.append(line)
            continue
        # 媒体 URL（可能是相对或绝对）
        absolute = urljoin(base_url, stripped)
        proxy = "/api/proxy?url=" + quote(absolute, safe="")
        result.append(proxy)
    return "\n".join(result)


def _get_proxies_for_url(url: str):
    """根据健康检查缓存，决定该 URL 是否使用 Clash 代理"""
    health = get_channel_health(url)
    mode = health.get("mode", "unknown")
    # direct 可用 → 不用 Clash
    # proxy 可用 或 unknown → 用 Clash（保险起见）
    # none → 用 Clash 试试
    if mode == "direct":
        return NO_PROXIES
    return CLASH_PROXIES


@app.route("/api/proxy")
def api_proxy():
    """通用代理：代理视频流或任意 HTTP 资源，按需使用 Clash"""
    target = request.args.get("url")
    if not target:
        return "Missing ?url=", 400

    # 只允许 http/https
    parsed = urlparse(target)
    if parsed.scheme not in ("http", "https"):
        return "Only http/https allowed", 400

    headers = {}
    for k, v in request.headers.items():
        if k.lower() not in ("host", "connection", "accept-encoding"):
            headers[k] = v

    # 根据健康缓存决定 proxies
    proxies = _get_proxies_for_url(target)

    try:
        resp = requests.get(
            target,
            headers=headers,
            stream=True,
            timeout=60,
            proxies=proxies,
        )
        resp.raise_for_status()
    except Exception as e:
        return str(e), 502

    content_type = resp.headers.get("content-type", "").lower()

    # 检测是否是 m3u8 文件
    is_m3u8 = (
        target.endswith(".m3u8")
        or "mpegurl" in content_type
        or "m3u8" in content_type
    )

    if is_m3u8:
        # m3u8 文件很小，直接读取并重写 URL
        m3u8_content = resp.content.decode("utf-8", errors="ignore")
        rewritten = rewrite_m3u8(m3u8_content, target)
        response_headers = {
            "Content-Type": "application/vnd.apple.mpegurl",
            "Access-Control-Allow-Origin": "*",
        }
        return Response(rewritten, status=200, headers=response_headers)

    # 流式返回，过滤掉 chunked 相关头
    excluded = {"transfer-encoding", "content-encoding", "connection"}
    response_headers = {
        k: v for k, v in resp.headers.items() if k.lower() not in excluded
    }

    return Response(
        resp.iter_content(chunk_size=65536),
        status=resp.status_code,
        headers=response_headers,
        direct_passthrough=True,
    )


@app.route("/api/health")
def api_health():
    """批量检测指定 URL 列表"""
    urls = request.args.getlist("url")
    if not urls:
        return jsonify({"error": "Missing ?url="}), 400

    def _check(url):
        return {"url": url, **get_channel_health(url)}

    results = list(map(_check, urls))
    return jsonify({"results": results})


